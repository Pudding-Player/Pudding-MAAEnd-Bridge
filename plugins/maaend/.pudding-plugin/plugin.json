{
  "schemaVersion": 1,
  "id": "maaend",
  "name": "MaaEnd 桥",
  "version": "0.3.0",
  "description": "MaaEnd 独立原生适配：发现任务与实例，按既有选项运行任务，停止并核实，版本化调整任务顺序、启停与声明参数。",
  "skills": [
    "./skills"
  ],
  "httpTools": [
    {
      "name": "status",
      "title": "MaaEnd 总览",
      "description": "读取 MaaEnd 后端心跳、MaaFramework 初始化状态、全部实例状态（connected/resource_loaded/tasker_inited/is_running/task_run_state）与当前任务目录指纹（catalogHash）。所有写操作前先用它核对环境与实例就绪情况。",
      "inputSchema": {
        "type": "object",
        "properties": {},
        "additionalProperties": false
      },
      "method": "POST",
      "url": "http://127.0.0.1:23121/status",
      "headers": {
        "X-Pudding-Token": "${ENV:MAAEND_BRIDGE_TOKEN}"
      },
      "timeoutMs": 25000,
      "execution": {
        "effect": "readOnly",
        "effectIsDynamic": false,
        "concurrencySafe": true,
        "risk": "observe",
        "concurrency": "readParallel",
        "modelUsage": "none",
        "maxResultChars": 24000,
        "deferred": true,
        "alwaysLoad": false,
        "exposure": "always",
        "promptVisible": false
      }
    },
    {
      "name": "catalog.search",
      "title": "MaaEnd 任务目录搜索",
      "description": "在运行中宿主实时反射的任务目录里按关键词检索任务与选项（名称、条目、翻译标签、说明），返回 catalogHash 供后续写操作作证据。",
      "inputSchema": {
        "type": "object",
        "required": [
          "query"
        ],
        "properties": {
          "query": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 50
          }
        },
        "additionalProperties": false
      },
      "method": "POST",
      "url": "http://127.0.0.1:23121/catalog/search",
      "headers": {
        "X-Pudding-Token": "${ENV:MAAEND_BRIDGE_TOKEN}"
      },
      "timeoutMs": 25000,
      "execution": {
        "effect": "readOnly",
        "effectIsDynamic": false,
        "concurrencySafe": true,
        "risk": "observe",
        "concurrency": "readParallel",
        "modelUsage": "none",
        "maxResultChars": 24000,
        "searchHint": "MaaEnd 任务与选项目录",
        "deferred": true,
        "alwaysLoad": false,
        "exposure": "always",
        "promptVisible": false,
        "searchProvider": true
      }
    },
    {
      "name": "catalog.describe",
      "title": "MaaEnd 任务/选项详情",
      "description": "查看运行中宿主声明的某个任务（条目、分组、控制器/资源要求、选项列表）或某个选项（类型、候选项、输入约束、默认值）的完整定义，附 catalogHash。",
      "inputSchema": {
        "type": "object",
        "required": [
          "name"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          }
        },
        "additionalProperties": false
      },
      "method": "POST",
      "url": "http://127.0.0.1:23121/catalog/describe",
      "headers": {
        "X-Pudding-Token": "${ENV:MAAEND_BRIDGE_TOKEN}"
      },
      "timeoutMs": 25000,
      "execution": {
        "effect": "readOnly",
        "effectIsDynamic": false,
        "concurrencySafe": true,
        "risk": "observe",
        "concurrency": "readParallel",
        "modelUsage": "none",
        "maxResultChars": 24000,
        "deferred": true,
        "alwaysLoad": false,
        "exposure": "afterRead",
        "promptVisible": false
      }
    },
    {
      "name": "read",
      "title": "MaaEnd 实例状态",
      "description": "读取实例运行状态；不传 instanceId 时返回全部实例与 MaaFramework 版本。任务提交后用它查询 task_run_state 判断真实进度，接纳回执不等于业务成功。",
      "inputSchema": {
        "type": "object",
        "properties": {
          "instanceId": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,128}$"
          }
        },
        "additionalProperties": false
      },
      "method": "POST",
      "url": "http://127.0.0.1:23121/read",
      "headers": {
        "X-Pudding-Token": "${ENV:MAAEND_BRIDGE_TOKEN}"
      },
      "timeoutMs": 25000,
      "execution": {
        "effect": "readOnly",
        "effectIsDynamic": false,
        "concurrencySafe": true,
        "risk": "observe",
        "concurrency": "readParallel",
        "modelUsage": "none",
        "verification": "state",
        "maxResultChars": 20000,
        "deferred": true,
        "alwaysLoad": false,
        "exposure": "afterRead",
        "promptVisible": false
      }
    },
    {
      "name": "invoke",
      "title": "MaaEnd 运行已声明任务",
      "description": "按该实例已保存的配置及声明默认值提交任务，自动生成选项覆盖和必要的 Agent 准备请求；同名任务重复时用 selectedTaskId 精确选择。只使用现存就绪实例，接纳不等于游戏业务完成。",
      "inputSchema": {
        "type": "object",
        "required": [
          "instanceId",
          "taskName",
          "catalogHash"
        ],
        "properties": {
          "instanceId": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,128}$"
          },
          "taskName": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "catalogHash": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "selectedTaskId": {
            "type": "string",
            "description": "config.read 返回的既有任务条目 ID；同名重复时必填"
          }
        },
        "additionalProperties": false
      },
      "method": "POST",
      "url": "http://127.0.0.1:23121/invoke",
      "headers": {
        "X-Pudding-Token": "${ENV:MAAEND_BRIDGE_TOKEN}"
      },
      "timeoutMs": 30000,
      "execution": {
        "effect": "gameWrite",
        "effectIsDynamic": false,
        "concurrencySafe": false,
        "risk": "high",
        "concurrency": "gameExclusive",
        "leaseScope": "game:maaend",
        "cancellation": "cooperative",
        "verification": "state",
        "modelUsage": "none",
        "maxResultChars": 12000,
        "deferred": true,
        "alwaysLoad": false,
        "exposure": "afterRead",
        "promptVisible": false
      }
    },
    {
      "name": "task.stop",
      "title": "MaaEnd 停止任务",
      "description": "请求停止指定实例当前运行的任务并回读 is_running 与 task_run_state 核实是否真正停下；停止请求超时或响应丢失时返回 unknown，不自动重试。",
      "inputSchema": {
        "type": "object",
        "required": [
          "instanceId"
        ],
        "properties": {
          "instanceId": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,128}$"
          }
        },
        "additionalProperties": false
      },
      "method": "POST",
      "url": "http://127.0.0.1:23121/task/stop",
      "headers": {
        "X-Pudding-Token": "${ENV:MAAEND_BRIDGE_TOKEN}"
      },
      "timeoutMs": 25000,
      "execution": {
        "effect": "gameWrite",
        "effectIsDynamic": false,
        "concurrencySafe": false,
        "concurrency": "gameExclusive",
        "leaseScope": "game:maaend",
        "verification": "state",
        "modelUsage": "none",
        "maxResultChars": 12000,
        "deferred": true,
        "alwaysLoad": false,
        "exposure": "afterRead",
        "promptVisible": false
      }
    },
    {
      "name": "config.read",
      "title": "MaaEnd 配置读取",
      "description": "读取当前配置的版本化快照（revision）与脱敏视图：实例、任务顺序、启停与选项值；密码与未知选项脱敏，凭据、路径与预执行程序不外发。写配置前先读，作为 baseRevision 证据。",
      "inputSchema": {
        "type": "object",
        "properties": {
          "instanceId": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,128}$"
          }
        },
        "additionalProperties": false
      },
      "method": "POST",
      "url": "http://127.0.0.1:23121/config/read",
      "headers": {
        "X-Pudding-Token": "${ENV:MAAEND_BRIDGE_TOKEN}"
      },
      "timeoutMs": 25000,
      "execution": {
        "effect": "readOnly",
        "effectIsDynamic": false,
        "concurrencySafe": true,
        "risk": "observe",
        "concurrency": "readParallel",
        "modelUsage": "none",
        "maxResultChars": 48000,
        "deferred": true,
        "alwaysLoad": false,
        "exposure": "afterRead",
        "promptVisible": false
      }
    },
    {
      "name": "config.update",
      "title": "MaaEnd 配置有限更新",
      "description": "带 catalogHash 与 baseRevision，只更新一个实例内既有任务顺序、启停及已声明的安全选项（包括热键）。不修改路径、密码、Agent、预程序或计划；保留未知字段，回读核实，不自动重放未知结果。",
      "inputSchema": {
        "type": "object",
        "required": [
          "instanceId",
          "catalogHash",
          "baseRevision"
        ],
        "properties": {
          "instanceId": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,128}$"
          },
          "catalogHash": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "baseRevision": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "taskOrder": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "minItems": 1
          },
          "taskEnabled": {
            "type": "object",
            "additionalProperties": {
              "type": "boolean"
            }
          },
          "optionValues": {
            "type": "object",
            "additionalProperties": {
              "type": "object"
            }
          }
        },
        "additionalProperties": false
      },
      "method": "POST",
      "url": "http://127.0.0.1:23121/config/update",
      "headers": {
        "X-Pudding-Token": "${ENV:MAAEND_BRIDGE_TOKEN}"
      },
      "timeoutMs": 60000,
      "execution": {
        "effect": "localWrite",
        "effectIsDynamic": false,
        "concurrencySafe": false,
        "concurrency": "serial",
        "scope": "fields",
        "scopeTarget": "instanceId",
        "scopeReader": "maaend.http.config.read",
        "verification": "state",
        "modelUsage": "none",
        "maxResultChars": 24000,
        "deferred": true,
        "alwaysLoad": false,
        "exposure": "afterRead",
        "promptVisible": false
      }
    },
    {
      "name": "capabilities.search",
      "title": "MaaEnd能力摘要搜索",
      "description": "按关键词查询已登记接口和当前宿主业务声明，空 query 分页浏览；只返回摘要。常规业务优先现有任务、应用与配置目录。能力缺口时可定位未适配项，随后用 capabilities.describe 读取单项契约；不扫描运行时对象。",
      "inputSchema": {
        "type": "object",
        "properties": {
          "query": {
            "type": "string",
            "maxLength": 256
          },
          "offset": {
            "type": "integer",
            "minimum": 0
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 20,
            "default": 8
          }
        },
        "required": [
          "query"
        ],
        "additionalProperties": false
      },
      "method": "POST",
      "url": "http://127.0.0.1:23121/capabilities/search",
      "headers": {
        "X-Pudding-Token": "${ENV:MAAEND_BRIDGE_TOKEN}"
      },
      "timeoutMs": 30000,
      "execution": {
        "effect": "readOnly",
        "effectIsDynamic": false,
        "risk": "observe",
        "concurrency": "readParallel",
        "concurrencySafe": true,
        "idempotency": "safeRetry",
        "modelUsage": "none",
        "verification": "none",
        "maxResultChars": 20000,
        "deferred": true,
        "alwaysLoad": false,
        "exposure": "onDemand",
        "promptVisible": false,
        "searchProvider": true
      }
    },
    {
      "name": "capabilities.describe",
      "title": "MaaEnd能力契约",
      "description": "读取 capabilities.search 返回的精确 id，取得来源、支持状态、调用映射、完整输入契约或业务目录详情入口；已发现、已支持、当前可调用及执行成功分别判断。",
      "inputSchema": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          }
        },
        "required": [
          "id"
        ],
        "additionalProperties": false
      },
      "method": "POST",
      "url": "http://127.0.0.1:23121/capabilities/describe",
      "headers": {
        "X-Pudding-Token": "${ENV:MAAEND_BRIDGE_TOKEN}"
      },
      "timeoutMs": 30000,
      "execution": {
        "effect": "readOnly",
        "effectIsDynamic": false,
        "risk": "observe",
        "concurrency": "readParallel",
        "concurrencySafe": true,
        "idempotency": "safeRetry",
        "modelUsage": "none",
        "verification": "none",
        "maxResultChars": 20000,
        "deferred": true,
        "alwaysLoad": false,
        "exposure": "onDemand",
        "promptVisible": false
      }
    },
    {
      "name": "host.inspect",
      "title": "MaaEnd缺口诊断（非常规入口）",
      "description": "仅在本轮常规接口已有具体缺口时检查现场静态结构。不是常规准备步骤。需要动态补足时携带能力目录签发的 gapId，取得现场 memberId 后先预览；不求值 getter、不构造对象、不执行表达式。",
      "inputSchema": {
        "type": "object",
        "properties": {
          "target": {
            "type": "string",
            "description": "interface、config 或 backend；后端方法仅来自已核对的公开 API 契约"
          },
          "path": {
            "type": "array",
            "items": {
              "type": "string",
              "maxLength": 256
            },
            "maxItems": 8,
            "description": "仅沿静态字典成员逐层定位，不执行表达式或 getter"
          },
          "query": {
            "type": "string",
            "maxLength": 256
          },
          "reason": {
            "type": "string",
            "enum": [
              "missingCapability",
              "contractDrift",
              "unavailableCapability"
            ]
          },
          "evidence": {
            "type": "string",
            "minLength": 8,
            "maxLength": 1000,
            "description": "本轮常规目录查询或接口失败的具体证据，不填泛泛探索理由"
          },
          "offset": {
            "type": "integer",
            "minimum": 0
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 50,
            "default": 20
          },
          "gapId": {
            "type": "string",
            "minLength": 16,
            "maxLength": 128,
            "description": "能力目录实际未命中、未适配或契约不可用时签发；仅有自填 evidence 不能放行动态写入"
          }
        },
        "required": [
          "target",
          "reason",
          "evidence"
        ],
        "additionalProperties": false
      },
      "method": "POST",
      "url": "http://127.0.0.1:23121/host/inspect",
      "headers": {
        "X-Pudding-Token": "${ENV:MAAEND_BRIDGE_TOKEN}"
      },
      "timeoutMs": 30000,
      "execution": {
        "effect": "readOnly",
        "effectIsDynamic": false,
        "risk": "observe",
        "concurrency": "readParallel",
        "concurrencySafe": true,
        "idempotency": "safeRetry",
        "modelUsage": "none",
        "verification": "none",
        "maxResultChars": 20000,
        "deferred": true,
        "alwaysLoad": false,
        "exposure": "onDemand",
        "promptVisible": false
      }
    },
    {
      "name": "host.prepare",
      "title": "预览缺口补足动作",
      "description": "仅当常规接口确有缺口时，使用本轮 gapId 和现场 memberId 预览动态方法调用或字段修改。核对目的、成员语义与影响；不执行目标。返回绑定会话、对象、签名／原值和全部参数的一次性 planId，五分钟过期。不得用于常规流程或保存快捷任务。",
      "inputSchema": {
        "type": "object",
        "properties": {
          "gapId": {
            "type": "string",
            "minLength": 16,
            "maxLength": 128
          },
          "memberId": {
            "type": "string",
            "minLength": 16,
            "maxLength": 128
          },
          "reason": {
            "type": "string",
            "enum": [
              "missingCapability",
              "contractDrift",
              "unavailableCapability"
            ]
          },
          "evidence": {
            "type": "string",
            "minLength": 8,
            "maxLength": 1000,
            "description": "本轮常规目录查询或接口失败的具体证据，不填泛泛探索理由"
          },
          "purpose": {
            "type": "string",
            "minLength": 8,
            "maxLength": 2000,
            "description": "本次用户目标、已核对的成员语义与资料依据，不能从名称猜作用"
          },
          "operation": {
            "type": "string",
            "enum": [
              "invoke",
              "set"
            ]
          },
          "arguments": {
            "type": "array",
            "maxItems": 32,
            "description": "Python 方法的位置参数，使用已检查的真实签名"
          },
          "keywords": {
            "type": "object",
            "maxProperties": 32,
            "description": "真实具名参数；MaaEnd 后端方法使用其公开声明参数"
          },
          "value": {
            "description": "已有字段的新简单值，保持现有类型；不能创建新字段或替换对象"
          }
        },
        "required": [
          "gapId",
          "memberId",
          "reason",
          "evidence",
          "purpose",
          "operation"
        ],
        "additionalProperties": false
      },
      "method": "POST",
      "url": "http://127.0.0.1:23121/host/prepare",
      "headers": {
        "X-Pudding-Token": "${ENV:MAAEND_BRIDGE_TOKEN}"
      },
      "timeoutMs": 30000,
      "execution": {
        "effect": "readOnly",
        "effectIsDynamic": false,
        "risk": "observe",
        "concurrencySafe": true,
        "concurrency": "readParallel",
        "idempotency": "safeRetry",
        "cancellation": "reliable",
        "verification": "none",
        "compensation": "none",
        "unattended": "forbidden",
        "modelUsage": "none",
        "deferred": true,
        "alwaysLoad": false,
        "exposure": "onDemand",
        "promptVisible": false,
        "maxResultChars": 20000
      }
    },
    {
      "name": "host.invoke",
      "title": "执行一次动态补足调用",
      "description": "仅用于常规接口确有缺口且已完成预览的动态方法调用。只接受 host.prepare 返回的当前一次性 planId，不接受原始路径、参数或脚本。不改变预览参数，不自动重试，不保存快捷任务。方法返回、请求接纳与业务完成分别核验。",
      "inputSchema": {
        "type": "object",
        "properties": {
          "planId": {
            "type": "string",
            "minLength": 16,
            "maxLength": 128
          }
        },
        "required": [
          "planId"
        ],
        "additionalProperties": false
      },
      "method": "POST",
      "url": "http://127.0.0.1:23121/host/invoke",
      "headers": {
        "X-Pudding-Token": "${ENV:MAAEND_BRIDGE_TOKEN}"
      },
      "timeoutMs": 30000,
      "execution": {
        "effect": "externalWrite",
        "effectIsDynamic": false,
        "risk": "high",
        "concurrencySafe": false,
        "concurrency": "serial",
        "idempotency": "neverRetry",
        "cancellation": "unconfirmed",
        "verification": "state",
        "compensation": "none",
        "unattended": "forbidden",
        "modelUsage": "unknown",
        "deferred": true,
        "alwaysLoad": false,
        "exposure": "onDemand",
        "promptVisible": false,
        "maxResultChars": 20000
      }
    },
    {
      "name": "host.set",
      "title": "执行一次动态补足修改",
      "description": "仅用于常规接口确有缺口且已完成预览的已有字段修改。使用一次性 planId，执行前复核原对象和原值；只改预览字段。Python 字段修改仅保证运行时状态，MaaEnd 使用官方版本化保存；回读失败或超时先核实，禁止自动重试。不能绕过专用配置与明确限制，不保存快捷任务。",
      "inputSchema": {
        "type": "object",
        "properties": {
          "planId": {
            "type": "string",
            "minLength": 16,
            "maxLength": 128
          }
        },
        "required": [
          "planId"
        ],
        "additionalProperties": false
      },
      "method": "POST",
      "url": "http://127.0.0.1:23121/host/set",
      "headers": {
        "X-Pudding-Token": "${ENV:MAAEND_BRIDGE_TOKEN}"
      },
      "timeoutMs": 30000,
      "execution": {
        "effect": "externalWrite",
        "effectIsDynamic": false,
        "risk": "high",
        "concurrencySafe": false,
        "concurrency": "serial",
        "idempotency": "neverRetry",
        "cancellation": "unconfirmed",
        "verification": "state",
        "compensation": "none",
        "unattended": "forbidden",
        "modelUsage": "unknown",
        "deferred": true,
        "alwaysLoad": false,
        "exposure": "onDemand",
        "promptVisible": false,
        "maxResultChars": 20000
      }
    }
  ]
}
